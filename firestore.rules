rules_version = '2';

// قواعد أمان «همّة» — الاشتراك: تجربة مجانية ثم تفعيل يدوي من المدير.
// انسخ هذا الملف كاملاً والصقه في: Firebase Console ← Firestore Database ← Rules ← Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== الإعدادات (عدّلها هنا وفي firebase-config.js) =====
    function adminEmails() { return ['latifa.saleh@hotmail.com']; }
    function trialDays() { return 7; }

    // ===== أدوات =====
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in adminEmails();
    }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function isMember(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }
    // العائلة مسموح لها: قديمة (بدون حقل active) أو مفعّلة أو داخل فترة التجربة
    function famOK(f) {
      return !('active' in f) || f.active == true
        || (('createdAt' in f) && f.createdAt is timestamp
            && request.time < f.createdAt + duration.value(trialDays(), 'd'));
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ===== المستخدمون =====
    match /users/{uid} {
      // صاحب الحساب، والمدير (لعرض الإيميلات وربط الحسابات)
      allow read, write: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // ===== رموز الدعوة =====
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.familyId);
    }

    // ===== العائلات =====
    match /families/{fid} {
      allow get: if isMember(fid) || isAdmin();
      allow list: if isAdmin();

      // عائلة جديدة: تبدأ غير مفعّلة، وتاريخ الإنشاء من السيرفر (بداية التجربة)
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == false
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        || (isMember(fid) && (
              // نقل الملكية عند المغادرة مسموح دائماً
              changed().hasOnly(['ownerUid'])
              // باقي التعديلات فقط إذا الاشتراك فعّال، وبدون لمس حقول الاشتراك
              || (famOK(resource.data)
                  && !changed().hasAny(['active', 'createdAt', 'ownerEmail']))
           ));

      allow delete: if isMember(fid) && resource.data.ownerUid == request.auth.uid;

      // ----- الأعضاء (الأب/الأم) -----
      match /members/{uid} {
        allow read: if isMember(fid) || isAdmin();
        allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && (
            // صاحب العائلة يضيف نفسه بعد الإنشاء
            get(famPath(fid)).data.ownerUid == uid
            // أو ينضم برمز دعوة صالح لنفس العائلة
            || (request.resource.data.code is string
                && exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
                && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.familyId == fid
                && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.expiresAt > request.time)
          ));
        allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow delete: if isAdmin() || (signedIn() && (request.auth.uid == uid || isMember(fid)));
      }

      // ----- سجل الأيام (المهام والنقاط) -----
      match /days/{day} {
        allow read, create, update: if isMember(fid) && famOK(get(famPath(fid)).data);
        allow delete: if isMember(fid);
      }
    }
  }
}
